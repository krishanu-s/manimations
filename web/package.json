{
  "name": "riemann-mapping",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:riemann && npm run build:feller && npm run build:ou && npm run build:entropy && npm run build:clt && npm run build:dist-interpolation && npm run build:gas-simulation && npm run build:chamber-diffusion && npm run build:vertical-chamber-diffusion",
    "build:riemann": "tsc --noEmit && esbuild src/riemann.ts --bundle --minify --outfile=dist/riemann.js",
    "build:feller": "tsc --noEmit && esbuild src/probability_dists/feller-entry.tsx --bundle --minify --outfile=dist/feller.js",
    "build:ou": "tsc --noEmit && esbuild src/probability_dists/ou-entry.tsx --bundle --minify --outfile=dist/ou.js",
    "build:entropy": "tsc --noEmit && esbuild src/probability_dists/entropy-bars-entry.tsx --bundle --minify --outfile=dist/entropy-bars.js",
    "build:clt": "tsc --noEmit && esbuild src/probability_dists/clt-entry.tsx --bundle --minify --outfile=dist/clt.js",
    "build:dist-interpolation": "tsc --noEmit && esbuild src/probability_dists/dist-interpolation-entry.tsx --bundle --minify --outfile=dist/dist-interpolation.js",
    "build:galton-board": "tsc --noEmit && esbuild src/galton-board-entry.tsx --bundle --minify --outfile=dist/galton-board.js",
    "build:number-line-sort": "tsc --noEmit && esbuild src/number-line-sort-entry.tsx --bundle --minify --outfile=dist/number-line-sort.js",
    "build:gas-simulation": "tsc --noEmit && esbuild src/gas_simulations/gas-simulation-entry.tsx --bundle --minify --outfile=dist/gas-simulation.js",
    "build:chamber-diffusion": "tsc --noEmit && esbuild src/gas_simulations/chamber-diffusion-entry.tsx --bundle --minify --outfile=dist/chamber-diffusion.js",
    "build:vertical-chamber-diffusion": "tsc --noEmit && esbuild src/gas_simulations/vertical-chamber-diffusion-entry.tsx --bundle --minify --outfile=dist/vertical-chamber-diffusion.js",
    "dev:riemann": "esbuild src/riemann.ts --bundle --sourcemap --outfile=dist/riemann.js --watch",
    "dev:feller": "esbuild src/feller-entry.tsx --bundle --sourcemap --outfile=dist/feller.js --watch",
    "dev:ou": "esbuild src/ou-entry.tsx --bundle --sourcemap --outfile=dist/ou.js --watch",
    "dev:entropy": "esbuild src/entropy-bars-entry.tsx --bundle --sourcemap --outfile=dist/entropy-bars.js --watch",
    "dev:clt": "esbuild src/clt-entry.tsx --bundle --sourcemap --outfile=dist/clt.js --watch",
    "dev:dist-interpolation": "esbuild src/dist-interpolation-entry.tsx --bundle --sourcemap --outfile=dist/dist-interpolation.js --watch",
    "dev:galton-board": "esbuild src/galton-board-entry.tsx --bundle --sourcemap --outfile=dist/galton-board.js --watch",
    "dev:number-line-sort": "esbuild src/number-line-sort-entry.tsx  --bundle --sourcemap --outfile=dist/number-line-sort.js --watch",
    "dev:gas-simulation": "esbuild src/gas_simulations/gas-simulation-entry.tsx --bundle --sourcemap --outfile=dist/gas-simulation.js --watch",
    "dev:chamber-diffusion": "esbuild src/gas_simulations/chamber-diffusion-entry.tsx --bundle --sourcemap --outfile=dist/chamber-diffusion.js --watch",
    "deploy": "cp dist/* '/Users/ksankar/Local Sites/krishanusankar/app/public/wp-content/themes/assembler/assets/js/'",
    "build:deploy": "npm run build && npm run deploy"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ml-matrix": "^6.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
