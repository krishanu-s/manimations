{
  "name": "riemann-mapping",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/riemann.ts --bundle --minify --outfile=dist/riemann.js",
    "build:feller": "tsc --noEmit && esbuild src/feller-entry.tsx --bundle --minify --outfile=dist/feller.js",
    "build:ou": "tsc --noEmit && esbuild src/ou-entry.tsx --bundle --minify --outfile=dist/ou.js",
    "build:entropy": "tsc --noEmit && esbuild src/entropy-bars-entry.tsx --bundle --minify --outfile=dist/entropy-bars.js",
    "dev": "esbuild src/riemann.ts --bundle --sourcemap --outfile=dist/riemann.js --watch",
    "dev:feller": "esbuild src/feller-entry.tsx --bundle --sourcemap --outfile=dist/feller.js --watch",
    "dev:ou": "esbuild src/ou-entry.tsx --bundle --sourcemap --outfile=dist/ou.js --watch",
    "dev:entropy": "esbuild src/entropy-bars-entry.tsx --bundle --sourcemap --outfile=dist/entropy-bars.js --watch",
    "deploy": "cp dist/* '/Users/ksankar/Local Sites/krishanusankar/app/public/wp-content/themes/assembler/assets/js/'",
    "build:deploy": "npm run build && npm run deploy"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
